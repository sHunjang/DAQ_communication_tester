# 프로젝트 특정 파일
# =================================================================
# 로그 파일
logs/
*.log
*.csv
*.txt

# 출력 파일
output/
*.xlsx

# Mock Serial 통신 임시 폴더
mock_serial_comm/
**/mock_serial_comm/

# 테스트 로그 폴더
test_logs/

# 임시 파일
temp/
tmp/
*.tmp
*.bak
*.swp
*.swo

# =================================================================
# IDE 설정
# =================================================================
# VSCode
.vscode/
*.code-workspace

# PyCharm
.idea/
*.iml
*.iws
*.ipr

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim
*.swp
*.swo
*~

# =================================================================
# OS 관련
# =================================================================
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msix
*.msm
*.msp
*.lnk

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk

# Linux
*~
.directory
.Trash-*
.nfs*

# =================================================================
# 기타
# =================================================================
# 백업 파일
*.backup
*_backup
backup/

# 데이터 파일 (필요시 추적 제외)
# data/
# *.dat

# 설정 파일 (로컬 설정만)
config/local_config.py
*_local.py

# 문서 임시 파일
~$*
